.cond {
  display: flex;
  flex-direction: row;
  flex-wrap: nowrap;
  gap: 8rpx;
  align-items: center;
  margin-bottom: 12rpx;
}
.picker.mini,
.input.mini {
  flex: 1;
  min-width: 0;
  padding: 10rpx 12rpx;
  font-size: 22rpx;
}
.cond .btn,
.cond button.btn {
  flex: none !important;
  padding: 8rpx 14rpx !important;
  font-size: 22rpx !important;
}
